{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/stream.ts": {
      "maxDuration": 60
    },
    "api/background-run.ts": {
      "maxDuration": 240
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/background-run",
      "schedule": "* * * * *"
    }
  ]
}
