# Upstash Redis REST connection used by the Vercel serverless functions for
# cross-invocation state. Copy this file to .env and fill in your own values,
# or set these in the Vercel project environment. Both are required on Vercel.

# REST endpoint URL of your Upstash Redis store.
UPSTASH_REDIS_REST_URL=https://your-store.upstash.io

# REST access token for your Upstash Redis store.
UPSTASH_REDIS_REST_TOKEN=your-rest-token
